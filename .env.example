# The DMV Hub local/deploy configuration.
# Copy to .env.local for local development. Set the same keys in Vercel for deploys.

# Optional: use one Formspree form for both contact and event submissions.
FORMSPREE_FORM_ID=

# Optional: override contact and event submissions separately.
FORMSPREE_CONTACT_FORM_ID=
FORMSPREE_EVENT_FORM_ID=

# Public support link. Keep blank until the real Ko-fi page exists.
NEXT_PUBLIC_KOFI_URL=

# Optional: manage events from a Google Sheet instead of data/events.ts.
# Paste the sheet's "Publish to web -> CSV" link here. Leave blank to use the
# built-in list in data/events.ts (which is always the fallback).
# Columns: title, date, area, location, vibe, description, discord, featured
EVENTS_SHEET_CSV_URL=
